{
  "manifest_version": 3,
  "name": "WhatsApp 本地聊天翻译 · Ego",
  "version": "0.1.2",
  "description": "本地翻译 WhatsApp 双方已发送消息，在原文下方显示中文；支持中文回复预览和手动填入，不自动发送。",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://web.whatsapp.com/*"],
    "js": ["core.js", "adapter.js", "engine.js", "styles.js", "panel-layout.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "WhatsApp 本地聊天翻译", "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
